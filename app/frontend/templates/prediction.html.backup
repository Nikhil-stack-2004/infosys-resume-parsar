<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Career Analysis | AI Career Intelligence Platform</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Inter, Arial, Helvetica, sans-serif;
            background: #f5f7fb;
            color: #172033;
            min-height: 100vh;
        }

        /* ================= NAVBAR ================= */

        .navbar {
            height: 70px;
            background: #ffffff;
            border-bottom: 1px solid #e6e9f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 6%;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 21px;
            font-weight: 800;
            color: #172033;
        }

        .logo span {
            color: #4f46e5;
        }

        .nav-links {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .nav-links a {
            text-decoration: none;
            color: #5f6878;
            font-size: 14px;
            font-weight: 600;
            padding: 10px 14px;
            border-radius: 8px;
            transition: 0.2s;
        }

        .nav-links a:hover {
            background: #f0f2ff;
            color: #4f46e5;
        }

        .nav-links .active {
            background: #eef2ff;
            color: #4f46e5;
        }

        /* ================= CONTAINER ================= */

        .container {
            width: 90%;
            max-width: 1180px;
            margin: 35px auto 60px;
        }

        /* ================= HEADER ================= */

        .breadcrumb {
            font-size: 13px;
            color: #7b8494;
            margin-bottom: 12px;
        }

        .breadcrumb strong {
            color: #4f46e5;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
            margin-bottom: 28px;
        }

        .page-header h1 {
            font-size: 32px;
            margin-bottom: 8px;
            letter-spacing: -0.6px;
        }

        .page-header p {
            color: #697386;
            font-size: 15px;
        }

        .step-badge {
            background: #111827;
            color: white;
            padding: 9px 15px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1px;
        }

        /* ================= CARDS ================= */

        .card {
            background: #ffffff;
            border: 1px solid #e5e8ef;
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 22px;
            box-shadow: 0 6px 20px rgba(15, 23, 42, 0.04);
        }

        .card h2 {
            font-size: 20px;
            margin-bottom: 8px;
        }

        .section-description {
            color: #697386;
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        /* ================= PROFILE ================= */

        .profile-card {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .profile-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .avatar {
            width: 54px;
            height: 54px;
            border-radius: 14px;
            background: #eef2ff;
            color: #4f46e5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: 800;
        }

        .profile-name {
            font-size: 19px;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .profile-email {
            color: #7b8494;
            font-size: 13px;
        }

        /* ================= RESUME SCORE ================= */

        .score-card {
            text-align: center;
        }

        .score-title {
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .score-subtitle {
            color: #7b8494;
            font-size: 13px;
            margin-bottom: 25px;
        }

        .score-circle {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            border: 11px solid #eef2ff;
            margin: 0 auto 22px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .score-number {
            font-size: 40px;
            font-weight: 800;
            color: #4f46e5;
        }

        .score-out-of {
            font-size: 12px;
            color: #7b8494;
            font-weight: 700;
        }

        /* ================= BREAKDOWN ================= */

        .breakdown-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
            margin-top: 20px;
        }

        .breakdown-item {
            border: 1px solid #e7eaf0;
            border-radius: 11px;
            padding: 15px;
            background: #fafbfc;
        }

        .breakdown-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 9px;
            gap: 10px;
        }

        .breakdown-name {
            font-size: 13px;
            font-weight: 700;
        }

        .breakdown-score {
            font-size: 13px;
            font-weight: 800;
            color: #4f46e5;
        }

        .breakdown-track {
            height: 7px;
            background: #e8ebf0;
            border-radius: 10px;
            overflow: hidden;
        }

        .breakdown-bar {
            height: 100%;
            width: 0;
            background: #4f46e5;
            border-radius: 10px;
            transition: width 0.5s ease;
        }

        /* ================= SUGGESTIONS ================= */

        .suggestions {
            margin-top: 20px;
        }

        .suggestion {
            display: flex;
            gap: 10px;
            align-items: flex-start;
            padding: 13px 15px;
            background: #fffaf0;
            border: 1px solid #f5dfae;
            border-radius: 10px;
            margin-bottom: 9px;
            color: #795b18;
            font-size: 13px;
            line-height: 1.5;
        }

        .suggestion-icon {
            font-weight: 800;
            flex-shrink: 0;
        }

        /* ================= PROFILE DETAILS ================= */

        .details-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-top: 20px;
        }

        .detail-item {
            background: #f8fafc;
            border: 1px solid #edf0f4;
            border-radius: 11px;
            padding: 16px;
        }

        .detail-label {
            font-size: 11px;
            color: #8992a2;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }

        .detail-value {
            font-size: 14px;
            font-weight: 700;
            color: #374151;
            word-break: break-word;
        }

        /* ================= SKILLS ================= */

        .skill-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 15px;
        }

        .skill-tag {
            display: inline-flex;
            align-items: center;
            background: #eef2ff;
            border: 1px solid #dfe3ff;
            color: #4338ca;
            padding: 8px 11px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
        }

        /* ================= PREDICTIONS ================= */

        .prediction-list {
            margin-top: 20px;
        }

        .prediction-item {
            border: 1px solid #e5e8ef;
            border-radius: 13px;
            padding: 18px;
            margin-bottom: 12px;
            background: #ffffff;
        }

        .prediction-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            gap: 15px;
        }

        .prediction-role {
            font-size: 15px;
            font-weight: 800;
        }

        .prediction-confidence {
            color: #4f46e5;
            font-size: 14px;
            font-weight: 800;
        }

        .prediction-track {
            height: 8px;
            background: #e9edf3;
            border-radius: 10px;
            overflow: hidden;
        }

        .prediction-bar {
            height: 100%;
            width: 0;
            background: #4f46e5;
            border-radius: 10px;
            transition: width 0.5s ease;
        }

        /* ================= GAP ANALYSIS ================= */

        .gap-card {
            border: 1px solid #e5e8ef;
            border-radius: 14px;
            padding: 20px;
            margin-top: 15px;
            background: #ffffff;
        }

        .gap-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }

        .gap-role {
            font-size: 16px;
            font-weight: 800;
        }

        .readiness {
            background: #eef2ff;
            color: #4338ca;
            border-radius: 20px;
            padding: 7px 11px;
            font-size: 12px;
            font-weight: 800;
        }

        .gap-section {
            margin-top: 18px;
        }

        .gap-section-title {
            font-size: 12px;
            font-weight: 800;
            margin-bottom: 9px;
            color: #4b5563;
        }

        .gap-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .gap-tag {
            padding: 7px 10px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 700;
        }

        .gap-match {
            background: #ecfdf3;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }

        .gap-missing {
            background: #fff1f2;
            color: #be123c;
            border: 1px solid #fecdd3;
        }

        /* ================= ACTIONS ================= */

        .actions {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 25px;
        }

        .action-btn {
            display: inline-block;
            text-decoration: none;
            padding: 12px 18px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 700;
        }

        .primary-btn {
            background: #4f46e5;
            color: white;
        }

        .primary-btn:hover {
            background: #4338ca;
        }

        .dark-btn {
            background: #111827;
            color: white;
        }

        .dark-btn:hover {
            background: #1f2937;
        }

        /* ================= EMPTY ================= */

        .empty {
            padding: 20px;
            background: #f8fafc;
            border-radius: 10px;
            color: #7b8494;
            font-size: 13px;
        }

        /* ================= FOOTER ================= */

        .footer {
            text-align: center;
            color: #929aaa;
            font-size: 11px;
            margin-top: 35px;
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 800px) {

            .navbar {
                height: auto;
                padding: 15px 5%;
                flex-direction: column;
                gap: 12px;
            }

            .nav-links {
                width: 100%;
                overflow-x: auto;
            }

            .nav-links a {
                white-space: nowrap;
                padding: 8px;
                font-size: 12px;
            }

            .container {
                width: 94%;
                margin-top: 25px;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .profile-card {
                flex-direction: column;
                align-items: flex-start;
            }

            .breakdown-grid,
            .details-grid {
                grid-template-columns: 1fr;
            }

        }

        @media (max-width: 550px) {

            .page-header h1 {
                font-size: 26px;
            }

            .card {
                padding: 20px;
            }

            .prediction-top,
            .gap-header {
                align-items: flex-start;
                flex-direction: column;
            }

        }

    </style>

</head>


<body>


<!-- ================= NAVIGATION ================= -->

<nav class="navbar">

    <div class="logo">
        Career<span>AI</span>
    </div>

    <div class="nav-links">

        <a href="/">
            Home
        </a>

        <a href="/upload">
            Upload Resume
        </a>

        <a href="/prediction" class="active">
            Prediction
        </a>

        <a href="/job-match">
            Job Match
        </a>

        <a href="/interview-coach">
            Interview Coach
        </a>

    </div>

</nav>


<!-- ================= MAIN ================= -->

<main class="container">


    <!-- HEADER -->

    <div class="breadcrumb">

        Career Intelligence
        /
        <strong>Career Analysis</strong>

    </div>


    <div class="page-header">

        <div>

            <h1>
                Career Intelligence Report
            </h1>

            <p>
                AI-powered resume analysis, role prediction and skill-gap insights.
            </p>

        </div>

        <div class="step-badge">
            STEP 03
        </div>

    </div>


    <!-- ================= PROFILE ================= -->

    <section class="card profile-card">

        <div class="profile-left">

            <div class="avatar">

                {{ resume_details.name[0]|upper
                   if resume_details.name
                   else "C" }}

            </div>


            <div>

                <div class="profile-name">

                    {{ resume_details.name
                       if resume_details.name
                       else "Candidate" }}

                </div>

                <div class="profile-email">

                    {{ resume_details.email
                       if resume_details.email
                       else "Email not detected" }}

                </div>

            </div>

        </div>

    </section>


    <!-- ================= RESUME SCORE ================= -->

    <section class="card score-card">

        <div class="score-title">
            Resume Quality Score
        </div>

        <div class="score-subtitle">
            Based on resume completeness and structure
        </div>


        <div class="score-circle">

            <div class="score-number">

                {{ resume_score.get("score", 0) }}

            </div>

            <div class="score-out-of">
                OUT OF 100
            </div>

        </div>


        <!-- BREAKDOWN -->

        {% if resume_score.get("breakdown") %}

        <div class="breakdown-grid">

            {% for item in resume_score.get("breakdown", []) %}

                {% set category =
                    item.get("category")
                    or item.get("label")
                    or item.get("name")
                    or "Category"
                %}

                {% set item_score =
                    item.get("score", 0)
                %}

                {% set max_score =
                    item.get("max_score", 100)
                %}

                <div class="breakdown-item">

                    <div class="breakdown-top">

                        <span class="breakdown-name">
                            {{ category }}
                        </span>

                        <span class="breakdown-score">

                            {{ item_score }}/{{ max_score }}

                        </span>

                    </div>


                    <div class="breakdown-track">

                        <div
                            class="breakdown-bar"
                            data-score="{{ item_score }}"
                            data-max="{{ max_score }}"
                        ></div>

                    </div>

                </div>

            {% endfor %}

        </div>

        {% endif %}


        <!-- SUGGESTIONS -->

        {% if resume_score.get("suggestions") %}

        <div class="suggestions">

            <h3 style="font-size: 15px; margin-bottom: 12px;">
                Resume Improvements
            </h3>


            {% for suggestion in resume_score.get("suggestions", []) %}

                <div class="suggestion">

                    <span class="suggestion-icon">
                        !
                    </span>

                    <span>
                        {{ suggestion }}
                    </span>

                </div>

            {% endfor %}

        </div>

        {% endif %}

    </section>


    <!-- ================= RESUME PROFILE ================= -->

    <section class="card">

        <h2>
            Resume Profile
        </h2>

        <p class="section-description">
            Key information extracted from your uploaded resume.
        </p>


        <div class="details-grid">


            <div class="detail-item">

                <div class="detail-label">
                    Name
                </div>

                <div class="detail-value">

                    {{ resume_details.name
                       if resume_details.name
                       else "Not detected" }}

                </div>

            </div>


            <div class="detail-item">

                <div class="detail-label">
                    Email
                </div>

                <div class="detail-value">

                    {{ resume_details.email
                       if resume_details.email
                       else "Not detected" }}

                </div>

            </div>


            <div class="detail-item">

                <div class="detail-label">
                    Phone
                </div>

                <div class="detail-value">

                    {{ resume_details.phone
                       if resume_details.phone
                       else "Not detected" }}

                </div>

            </div>


            <div class="detail-item">

                <div class="detail-label">
                    Education
                </div>

                <div class="detail-value">

                    {{ resume_details.education
                       if resume_details.education
                       else "Not detected" }}

                </div>

            </div>


            <div class="detail-item">

                <div class="detail-label">
                    Experience
                </div>

                <div class="detail-value">

                    {{ resume_details.experience
                       if resume_details.experience
                       else "Not detected" }}

                </div>

            </div>


        </div>


        <!-- SKILLS -->

        <div style="margin-top: 25px;">

            <div class="detail-label">
                Technical Skills
            </div>


            <div class="skill-tags">

                {% if resume_details.skills %}

                    {% if resume_details.skills is string %}

                        {% for skill in resume_details.skills.split(",") %}

                            {% if skill.strip() %}

                                <span class="skill-tag">
                                    {{ skill.strip() }}
                                </span>

                            {% endif %}

                        {% endfor %}

                    {% else %}

                        {% for skill in resume_details.skills %}

                            <span class="skill-tag">
                                {{ skill }}
                            </span>

                        {% endfor %}

                    {% endif %}

                {% else %}

                    <span class="skill-tag">
                        No skills detected
                    </span>

                {% endif %}

            </div>

        </div>

    </section>


    <!-- ================= ROLE PREDICTIONS ================= -->

    <section class="card">

        <h2>
            Predicted Career Roles
        </h2>

        <p class="section-description">
            Role predictions generated from the skills and information detected in your resume.
        </p>


        <div class="prediction-list">

            {% if predictions %}

                {% for prediction in predictions %}

                    {% set role =
                        prediction.get("role", "Technology")
                    %}

                    {% set probability =
                        prediction.get("confidence", 0)
                    %}


                    <div class="prediction-item">

                        <div class="prediction-top">

                            <span class="prediction-role">
                                {{ role }}
                            </span>

                            <span class="prediction-confidence">

                                {% if probability <= 1 %}

                                    {{ (probability * 100)|round(1) }}%

                                {% else %}

                                    {{ probability|round(1) }}%

                                {% endif %}

                            </span>

                        </div>


                        <div class="prediction-track">

                            <div
                                class="prediction-bar"
                                data-score="{{ probability }}"
                            ></div>

                        </div>

                    </div>

                {% endfor %}

            {% else %}

                <div class="empty">
                    No career predictions are available.
                </div>

            {% endif %}

        </div>

    </section>


    <!-- ================= SKILL GAP ANALYSIS ================= -->

    {% if gap_reports %}

    <section class="card">

        <h2>
            Skill Gap Analysis
        </h2>

        <p class="section-description">
            Compare your resume skills with the skills associated with predicted career roles.
        </p>


        {% for report in gap_reports %}

            <div class="gap-card">

                <div class="gap-header">

                    <div class="gap-role">

                        {{ report.get("role", "Career Role") }}

                    </div>


                    <div class="readiness">

                        {{ report.get("readiness", 0) }}%
                        Readiness

                    </div>

                </div>


                <!-- MATCHING SKILLS -->

                {% set matching =
                    report.get("matching_skills", [])
                %}

                {% if matching %}

                <div class="gap-section">

                    <div class="gap-section-title">
                        Matching Skills
                    </div>


                    <div class="gap-tags">

                        {% if matching is string %}

                            {% for skill in matching.split(",") %}

                                {% if skill.strip() %}

                                    <span class="gap-tag gap-match">
                                        {{ skill.strip() }}
                                    </span>

                                {% endif %}

                            {% endfor %}

                        {% else %}

                            {% for skill in matching %}

                                <span class="gap-tag gap-match">
                                    {{ skill }}
                                </span>

                            {% endfor %}

                        {% endif %}

                    </div>

                </div>

                {% endif %}


                <!-- MISSING SKILLS -->

                {% set missing =
                    report.get("missing_skills", [])
                %}

                {% if missing %}

                <div class="gap-section">

                    <div class="gap-section-title">
                        Skills to Develop
                    </div>


                    <div class="gap-tags">

                        {% if missing is string %}

                            {% for skill in missing.split(",") %}

                                {% if skill.strip() %}

                                    <span class="gap-tag gap-missing">
                                        {{ skill.strip() }}
                                    </span>

                                {% endif %}

                            {% endfor %}

                        {% else %}

                            {% for skill in missing %}

                                <span class="gap-tag gap-missing">
                                    {{ skill }}
                                </span>

                            {% endfor %}

                        {% endif %}

                    </div>

                </div>

                {% endif %}


            </div>

        {% endfor %}

    </section>

    {% endif %}


    <!-- ================= ACTIONS ================= -->

    <div class="actions">

        <a
            href="/job-match"
            class="action-btn primary-btn"
        >
            Match With a Job
        </a>


        <a
            href="/interview-coach"
            class="action-btn dark-btn"
        >
            Start Interview Coach
        </a>


        <a
            href="/upload"
            class="action-btn dark-btn"
        >
            Analyze Another Resume
        </a>

    </div>


    <div class="footer">

        AI-Powered Career Intelligence Platform
        • Career Analysis

    </div>


</main>


<!-- ================= JAVASCRIPT ================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        /* ================= BREAKDOWN BARS ================= */

        const breakdownBars =
            document.querySelectorAll(".breakdown-bar");

        breakdownBars.forEach(function (bar) {

            const score =
                parseFloat(
                    bar.getAttribute("data-score")
                );

            const max =
                parseFloat(
                    bar.getAttribute("data-max")
                );

            if (
                Number.isNaN(score) ||
                Number.isNaN(max) ||
                max <= 0
            ) {
                return;
            }

            const percentage =
                Math.max(
                    0,
                    Math.min(
                        100,
                        (score / max) * 100
                    )
                );

            bar.style.width =
                percentage + "%";

        });


        /* ================= PREDICTION BARS ================= */

        const predictionBars =
            document.querySelectorAll(".prediction-bar");

        predictionBars.forEach(function (bar) {

            let score =
                parseFloat(
                    bar.getAttribute("data-score")
                );

            if (Number.isNaN(score)) {
                return;
            }

            if (score <= 1) {
                score = score * 100;
            }

            score =
                Math.max(
                    0,
                    Math.min(
                        100,
                        score
                    )
                );

            bar.style.width =
                score + "%";

        });

    });

</script>


</body>
</html>